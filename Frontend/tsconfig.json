{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "strict": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noUnusedLocals": true,
  }
}